# --- Used by the app (safe to expose to the browser) ---
# Supabase project URL and anon key (Project Settings → API).
# Leave both blank to run on the bundled data/birds.json with no database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL, used in share text (e.g. https://lifer.up.railway.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Used only by `npm run seed` (never expose to the browser) ---
SUPABASE_SERVICE_ROLE_KEY=
# Contact info for the User-Agent sent to iNaturalist / Wikimedia
SEED_CONTACT=you@example.com
